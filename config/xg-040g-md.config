#
# Target
#
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_bell_xg-040g-md=y
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_LINUX_6_12=y

#
# Airoha hardware
#
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_kmod-i2c-an7581=y

#
# Base system - the essential minimal system
#
CONFIG_DEFAULT_base-files=y
CONFIG_DEFAULT_busybox=y                  # Minimal coreutils; almost every command relies on it
CONFIG_DEFAULT_ca-bundle=y                # Root CA bundle (required for https/wget/curl)
CONFIG_DEFAULT_logd=y                     # System log daemon
CONFIG_DEFAULT_procd=y                    # init system / service manager core
CONFIG_DEFAULT_uci=y                      # Configuration system (/etc/config/*)
CONFIG_DEFAULT_urandom-seed=y             # Random seed save/restore (crypto-related)
CONFIG_DEFAULT_urngd=y                    # Userspace RNG daemon
CONFIG_DEFAULT_netifd=y                   # Network interface manager core
CONFIG_DEFAULT_mtd=y                      # Flash operation tools
CONFIG_DEFAULT_fstools=y                  # Filesystem mount/check tools
CONFIG_DEFAULT_block-mount=y              # Block device mount support (USB drives, etc.)
CONFIG_DEFAULT_libc=y
CONFIG_DEFAULT_libgcc=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-ubootenv-nvram=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y

#
# Network - basic IPv4/IPv6 stack
#
CONFIG_PACKAGE_dnsmasq=y             # DNS + DHCP + TFTP (full version supports more features)
CONFIG_PACKAGE_ip-full=y
CONFIG_IPV6=y                             # Global IPv6 support (kernel option, not a package)
CONFIG_DEFAULT_odhcp6c=y                  # IPv6 DHCP client
CONFIG_DEFAULT_odhcpd-ipv6only=y          # IPv6-only DHCP server (works with dnsmasq)
CONFIG_PACKAGE_nftables=y                 # nft core tools
CONFIG_PACKAGE_firewall4=y                # nftables-based firewall (replaces old firewall)
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y         # nft hardware flow offload (if the SoC supports it)
CONFIG_PACKAGE_ethtool-full=y             # Inspect link speed, duplex, and auto-negotiation status.

#
# Package manager: apk
#
# Add this line (enabled by default, set explicitly to be safe):
CONFIG_PACKAGE_apk=y
CONFIG_DEFAULT_apk-tools=y                # apk main package
CONFIG_PACKAGE_apk-mbedtls=y
CONFIG_DEFAULT_openwrt-keyring=y          # Signature verification keyring (used by apk, shipped by official images)

#
# PPPoE
#
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

#
# SSH
#
CONFIG_PACKAGE_dropbear=y
CONFIG_DROPBEAR_SMALL_CODE=y
CONFIG_DROPBEAR_ED25519=y
CONFIG_DROPBEAR_CURVE25519=y

#
# USB
#
CONFIG_USB_SUPPORT=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y

#
# Filesystem (extroot)
#
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y

#
# LuCI language
#
# CONFIG_LUCI_LANG_zh_Hans is not set
# CONFIG_PACKAGE_luci-i18n-base-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-firewall-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn is not set

#
# Extra packages (user customizations, not core defaults)
#
CONFIG_PACKAGE_luci=y                 # Web management
CONFIG_PACKAGE_luci-ssl=y                 # LuCI HTTPS support
CONFIG_PACKAGE_luci-theme-argon=y         # Use the Argon theme by default
# CONFIG_PACKAGE_luci-app-argon-config is not set    # Argon theme settings page
# CONFIG_PACKAGE_luci-theme-bootstrap is not set     # Keep the bootstrap theme package
CONFIG_PACKAGE_umdns=y                    # Local mDNS/zeroconf support (hostname.local resolution)
CONFIG_PACKAGE_kmod-mtd-rw=y              # Temporary MTD write access (for NAND/eMMC recovery or flashing)
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_fwtool=y
CONFIG_PACKAGE_cups=y
CONFIG_PACKAGE_nano=y

#
# HomeProxy (proxy software)
#
# CONFIG_PACKAGE_luci-app-homeproxy is not set

#
# PassWall (proxy software)
#
# CONFIG_PACKAGE_luci-app-passwall is not set
# PassWall core proxy components (commented out to avoid a homeproxy dependency loop)
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_xray-core=y is not set
# Optional: other protocol support (enable as needed)
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_naiveproxy is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_v2ray-core is not set

#
# Kernel modules required for transparent proxy
#
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-socket=y

#
# V2RayA (optional proxy software)
#
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-proto-modemmanager=y
CONFIG_PACKAGE_luci-app-adguardhome=y

#
# Build options
#
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_CCACHE_DIR="/mnt/openwrt/ccache"
